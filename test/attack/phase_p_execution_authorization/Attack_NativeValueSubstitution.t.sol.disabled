pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {AkmenaCore} from "../../../src/core/AkmenaCore.sol";
import {AkmenaPolicyBoundary} from "../../../src/authorization/AkmenaPolicyBoundary.sol";

contract NativeValueTarget {

    uint256 public callCount;
    uint256 public lastValue;

    function receiveValue()
        external
        payable
    {
        callCount += 1;
        lastValue = msg.value;
    }
}

contract Attack_NativeValueSubstitutionTest is Test {

    AkmenaCore internal core;
    AkmenaPolicyBoundary internal boundary;
    NativeValueTarget internal target;

    address internal operator =
        address(0x1111);

    address internal agent =
        address(0x2222);

    function setUp()
        public
    {
        core =
            new AkmenaCore();

        boundary =
            new AkmenaPolicyBoundary(
                address(core)
            );

        target =
            new NativeValueTarget();

        /*
         * Give the agent enough ETH to exercise
         * the boundary with real native value.
         */
        vm.deal(
            agent,
            200 ether
        );

        vm.prank(operator);

        boundary.setAgentPolicy(
            agent,
            1 ether,
            1 ether,
            false
        );
    }

    function test_Attack_NativeValueIsNotBoundToAuthorization()
        public
    {
        bytes memory payload =
            abi.encodeWithSelector(
                NativeValueTarget.receiveValue.selector
            );

        /*
         * Conceptual authorized execution:
         *
         * receiveValue{value: 1 ether}()
         */
        vm.prank(agent);

        boundary.executeAgentCall{
            value: 1 ether
        }(
            operator,
            address(target),
            0,
            bytes32(0),
            0,
            payload
        );

        assertEq(
            target.callCount(),
            1,
            "authorized native-value call did not execute"
        );

        assertEq(
            target.lastValue(),
            1 ether,
            "authorized native value was not received"
        );

        /*
         * Keep the SAME:
         *
         *   agent
         *   operator
         *   target
         *   selector
         *   calldata
         *
         * but substitute the ACTUAL msg.value.
         *
         * This is the critical diagnostic.
         */
        vm.prank(agent);

        boundary.executeAgentCall{
            value: 100 ether
        }(
            operator,
            address(target),
            0,
            bytes32(0),
            0,
            payload
        );

        /*
         * Diagnostic objective:
         *
         * If the boundary accepts this call, native
         * value is not bound to the authorization.
         */
        assertEq(
            target.callCount(),
            2,
            "native value substitution was blocked"
        );

        assertEq(
            target.lastValue(),
            100 ether,
            "substituted native value was blocked"
        );
    }
}
